# Copy this file to .env and fill in BOT_TOKEN.
# Commented-out variables are optional; the value shown is the default.

# Discord bot token
BOT_TOKEN=

# Discord server ID used for development
# DEBUG_GUILD_ID=

# Path to the SQLite database file
# DATABASE_PATH=dj4h.db

# RNGdle sync interval, in seconds (12 hours)
# RNGDLE_SYNC_INTERVAL=43200

# RNGdle table to percent sync interval, in seconds (7 days)
# RNGDLE_TABLE_SYNC_INTERVAL=604800

# Local user cache update interval, in seconds (30 minutes)
# USER_CACHE_SYNC_INTERVAL=1800
